<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://hcmc.uvic.ca/ns/staticSearch" version="1">
  <params>
    <searchFile>HTML/search.html</searchFile>
    <recurse>true</recurse>
    <linkToFragmentId>true</linkToFragmentId>
    <scrollToTextFragment>false</scrollToTextFragment>
    <phrasalSearch>true</phrasalSearch>
    <wildcardSearch>true</wildcardSearch>
    <createContexts>true</createContexts>
    <resultsPerPage>10</resultsPerPage>
    <minWordLength>2</minWordLength>
    <maxKwicsToHarvest>5</maxKwicsToHarvest>
    <maxKwicsToShow>3</maxKwicsToShow>
    <totalKwicLength>18</totalKwicLength>
    <kwicTruncateString>...</kwicTruncateString>
    <verbose>false</verbose>
    <stopwordsFile>../../staticseachDocs/staticSearch-1.4.7/staticSearch-1.4.7/xsl/english_stopwords.txt</stopwordsFile>
    <dictionaryFile>../../staticseachDocs/staticSearch-1.4.7/staticSearch-1.4.7/xsl/english_words.txt</dictionaryFile>
    <indentJSON>true</indentJSON>
    <outputFolder>staticSearch</outputFolder>
  </params>
  <rules>
    <rule weight="2" match="h1 | h2 | h3"/>
    <rule weight="0" match="script | style | noscript | nav | header | footer"/>
  </rules>
  <contexts>
    <context match="div[contains-token(@class, 'letter')]" label="Letters"/>
    <context match="div[contains-token(@class, 'notes')]" label="Paratext"/>
    <context match="div[contains-token(@class, 'paratext')]" label="Paratext"/>
    <context match="div[contains-token(@class, 'introduction')]" label="Paratext"/>
    <context match="div[contains-token(@class, 'appendix')]" label="Paratext"/>
  </contexts>
  <excludes>
    <exclude type="index" match="html[head/meta[@data-ss-exclude-index = 'true']]"/>
  </excludes>
</config>
